# Copy to legged.env (not committed) and fill in the robot and policy sources for
# 08-legged-sim2sim.sh. Both are git repositories reachable from the cluster.
ROBOT_TYPE=<robot model label>
# MJCF at <ROBOT_PATH>/xml/robot.xml and meshes at <ROBOT_PATH>/meshes/
ROBOT_DESCRIPTION_REPO=https://github.com/<org>/<robot-description>.git
ROBOT_PATH=<path/inside/repo>
# params.yaml and policy/<rl_type>/{policy,encoder}.onnx under <POLICY_PATH>
POLICY_REPO=https://github.com/<org>/<policy-repo>.git
POLICY_PATH=<path/inside/repo>
